# depOS backend environment variables. Copy to .env and fill in before running
# `depos-api` or the intelligence CLI.

# --- Supabase / Postgres ---------------------------------------------------
# Postgres connection string. For local `supabase start` the default is:
#   postgres://postgres:postgres@127.0.0.1:54322/postgres
# For hosted Supabase, use the pooled or direct connection URL from the dashboard.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project URL. Local: http://127.0.0.1:54321; Hosted: https://<ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Browser-facing Supabase URL for apps/web. Keep this aligned with SUPABASE_URL
# unless you intentionally need a different public value.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Anon (public) key. Safe to expose to the browser.
SUPABASE_ANON_KEY=replace-with-anon-key

# Browser-facing anon key for apps/web. Keep this aligned with SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Browser-facing depOS API base URL for apps/web. The Next app reads this from
# the repo-root .env and derives NEXT_PUBLIC_SUPABASE_* from SUPABASE_URL /
# SUPABASE_ANON_KEY automatically when not explicitly set.
NEXT_PUBLIC_DEPOS_API_URL=http://127.0.0.1:8080

# Server-side fallback read by apps/web/next.config.js when building NEXT_PUBLIC_DEPOS_API_URL.
DEPOS_API_URL=http://127.0.0.1:8080

# Service-role key. Server-only. Bypasses RLS. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# JWT verification. Local `supabase start` prints an HS256 secret; hosted
# projects use RS256 + JWKS (leave SUPABASE_JWT_SECRET unset in that case and
# set SUPABASE_JWT_ALG=RS256).
SUPABASE_JWT_ALG=HS256
SUPABASE_JWT_SECRET=replace-with-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

# --- depOS -----------------------------------------------------------------
# Root directory for graph snapshots and intelligence run artifacts.
DEPOS_DATA=depos-data

# CORS origins for the FastAPI server (comma-separated).
DEPOS_CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# Set to "production" to enforce strict startup checks (internal API key,
# explicit CORS, graph bucket). Leave empty for local dev.
DEPOS_ENV=

# Shared secret for worker/internal routes (/v1/snapshot, federation preview,
# drift with filesystem paths). When empty, those routes are open locally — do not
# expose the API publicly without setting a real secret.
DEPOS_INTERNAL_API_KEY=

# Supabase Storage bucket for graph JSON (must exist after migrations).
DEPOS_GRAPH_BUCKET=graph-snapshots

# HTTP port for depos-api (depos.api_server default 8080).
PORT=

# --- Intelligence layer (optional) -----------------------------------------
# Reasoning provider: gemma | openai | ollama | stub. See depos.analysis.config.
# Local Ollama is a practical default for dataset-pipeline and analyze repo/diff.
DEPOS_INTEL_PROVIDER=ollama

# Provider settings (only the ones matching DEPOS_INTEL_PROVIDER are read).
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMMA_API_URL=
GEMMA_MODEL=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# Optional JSON response field paths when the HTTP shape differs from defaults.
GEMMA_RESPONSE_PATH=
OPENAI_RESPONSE_PATH=
OLLAMA_RESPONSE_PATH=

# Bundle / reasoner tuning (optional). Empty = use code defaults in depos/analysis/config.py.
DEPOS_INTEL_TOKEN_BUDGET=
DEPOS_INTEL_EXTRA_SOURCE_ROOTS=
DEPOS_INTEL_PATH_ALIASES_JSON=
DEPOS_INTEL_MIN_EVIDENCE=
DEPOS_INTEL_MIN_EVIDENCE_SCORE=
DEPOS_REASONER_DISABLED_DETECTORS=
DEPOS_REASONER_MIN_EVIDENCE_BY_DETECTOR=
DEPOS_REASONER_MAX_CANDIDATES_BY_DETECTOR=
DEPOS_REASONER_MAX_RETRIES=
DEPOS_BUNDLE_MAX_CALLER_TEXTS=
DEPOS_BUNDLE_MAX_CALLEE_TEXTS=
DEPOS_BUNDLE_MAX_SEAM_NEIGHBOR_TEXTS=
DEPOS_BUNDLE_MAX_SNIPPET_CHARS=
DEPOS_BUNDLE_MAX_PROMPT_TOKENS=
DEPOS_PRODUCT_OUTPUTS_ENABLED=

# depOS fragment cache (optional; see depos/cache.py).
DEPOS_CACHE_ENABLED=
DEPOS_CACHE_CLEAR=

# LLM HTTP timeouts (seconds). Empty = defaults in ReasonerProviderConfig.
DEPOS_LLM_CONNECT_TIMEOUT=
DEPOS_LLM_READ_TIMEOUT=
DEPOS_LLM_OLLAMA_PREFLIGHT_TIMEOUT=
DEPOS_OLLAMA_FIRST_CALL_TIMEOUT=
DEPOS_LLM_OLLAMA_FIRST_CALL_TIMEOUT=
DEPOS_OLLAMA_SUBSEQUENT_TIMEOUT=
DEPOS_LLM_OLLAMA_SUBSEQUENT_TIMEOUT=

# Perf / parallelism (optional). See docs/perf-acceleration.md.
DEPOS_PERF_TAINT_N_JOBS=
DEPOS_PERF_BUNDLE_N_JOBS=
DEPOS_PERF_CFG_DFG_N_JOBS=
DEPOS_PERF_GRAPH_METRICS_EXPENSIVE=

# Reasoner replay / dataset layout (optional).
DEPOS_INTEL_DATA_DIR=
DEPOS_INTEL_RUN_OUTPUT_SUBDIR=

# Module 7 gray-zone panel: inherits DEPOS_INTEL_PROVIDER when unset. Use 0/false/off to disable Module 7.
DEPOS_GRAY_ZONE_ENABLED=
DEPOS_GRAY_ZONE_MODEL_A_PROVIDER=
DEPOS_GRAY_ZONE_MODEL_B_PROVIDER=
DEPOS_GRAY_ZONE_MODEL_C_PROVIDER=

# --- Optional: graphify CLI / tooling (defaults apply when unset) ----------
GRAPHIFY_CHANGED=
GRAPHIFY_WHISPER_MODEL=
GRAPHIFY_WHISPER_PROMPT=

# --- Optional: intelligence config toggles (see depos/analysis/config.py) ---
DEPOS_NO_CACHE=
DEPOS_CACHE_DIR=
DEPOS_PERF_METRICS_BACKEND=
